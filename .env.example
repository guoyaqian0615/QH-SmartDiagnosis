# Public browser API origin (no trailing slash). When unset, constitution uses the local Next.js proxy and clinical keeps local demo data.
NEXT_PUBLIC_API_BASE=

# DeepSeek official API (OpenAI‑compatible). When DEEPSEEK_API_KEY is set,
# /api/clinical/inference will use "graph retrieval + DeepSeek constrained generation".
# Note: the free web UI is not a stable programmatic interface; use the official API here.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=20000

# PostgreSQL 连接串（Vercel / Neon / Supabase 控制台复制；含 ssl 参数）
# 本地 Docker：docker compose up -d 后示例如下
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dbcnet?schema=public"
DATABASE_URL=

# 会话签名密钥，至少 16 字符，勿提交真实值
AUTH_SECRET="替换成_随机长字符串_至少16位"

# 种子用户（npx prisma db seed）：demo@example.com / demo1234
